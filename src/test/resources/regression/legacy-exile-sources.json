            "object": "ruling",
            "oracle_id": "cb9d557a-fc06-428c-8be6-7d28add33028",
            "source": "wotc",
            "published_at": "2018-12-07",
            "comment": "If a token is exiled this way, it won't return to the battlefield."
          },
          {
            "object": "ruling",
            "oracle_id": "cb9d557a-fc06-428c-8be6-7d28add33028",
            "source": "wotc",
            "published_at": "2018-12-07",
            "comment": "If Fiend Hunter leaves the battlefield before its first ability has resolved, its second ability will trigger and do nothing. Then its first ability will resolve and exile the target creature indefinitely. This is different from abilities on other cards that exile a permanent \"until\" something happens."
          }
        ]
