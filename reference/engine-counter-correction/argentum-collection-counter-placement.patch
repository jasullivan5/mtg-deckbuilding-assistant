diff --git a/rules-engine/src/test/kotlin/com/wingedsheep/engine/scenarios/CollectionCounterPlacementTest.kt b/rules-engine/src/test/kotlin/com/wingedsheep/engine/scenarios/CollectionCounterPlacementTest.kt
