#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")" && pwd)
source_dir=${ARGENTUM_ENGINE_DIR:-"$(dirname "$root")/argentum-engine"}
bash "$root/scripts/setup.sh"
task=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
case "$task" in
  build|test|run|installDist|clean|help) task=":assistant:$task" ;;
  *) echo 'Usage: ./dev {build|test|run|installDist|clean|help} [Gradle options]' >&2; exit 2 ;;
esac
# Conservative defaults for the large native Kotlin corpus; override with later Gradle options.
exec "$root/gradlew" -p "$source_dir" -I "$root/gradle/argentum.init.gradle" \
  --no-daemon --no-configuration-cache --max-workers=2 \
  -PkotlinCompileParallelism=1 -Pkotlin.daemon.jvmargs=-Xmx4g "$task" "$@"
